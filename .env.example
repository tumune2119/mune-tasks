# Copy this file to .env.local and fill in your key, then restart MUNE TASKS.
# Optional: without a key, MUNE TASKS uses the Claude Code CLI (your Claude subscription) instead.
ANTHROPIC_API_KEY=

# Optional: store the database somewhere else (default: ./data/mune-tasks.db)
# MUNE_TASKS_DB_PATH=C:\Users\you\Documents\MUNE TASKS\mune-tasks.db
